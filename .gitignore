# Large data files — never commit raw DFSAR/OHRC tiles to git
data/raw/*
!data/raw/MISSING_DATA.md
data/processed/
data/processed_real/

# Model checkpoints (potentially large)
/models/
/models_real/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Reports generated files (keep .md, ignore generated images)
reports/*.png
reports/gradcam/*.png
reports/real/*.png

# Environment
.env
*.egg-info/
dist/
build/
